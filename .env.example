# Servidor
PORT=8080
GIN_MODE=release

# Banco de dados (obrigatórias: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=pulso_db
DB_SSLMODE=disable

# JWT (obrigatória: JWT_SECRET)
JWT_SECRET=
JWT_EXPIRA_HORAS=24

# CORS e origem do WebSocket (separado por vírgula)
CORS_ORIGINS=http://localhost:3000

# Tempo real
POLL_INTERVAL_MS=2000

# Fuso usado nos limites de dia e agrupamentos
APP_TIMEZONE=America/Sao_Paulo

# Swagger UI em /swagger/index.html
SWAGGER_ENABLED=true
