# Servidor
PORT=8080
GIN_MODE=release

# Banco de dados (obrigatórias: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME)
#
# DB_HOST e DB_PORT dependem de onde a API roda:
#   - Fora do Docker (go run / debugger): o host do seu Postgres,
#     ex.: DB_HOST=localhost e DB_PORT=5432.
#   - Com docker compose: o compose força DB_HOST=db e DB_PORT=5432
#     (nome do serviço e porta interna). O valor daqui é ignorado.
#
# No docker compose, DB_USER, DB_PASSWORD e DB_NAME também são usados
# para CRIAR o usuário e o banco do container Postgres na primeira subida.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=pulso_db
DB_SSLMODE=disable

# Porta do Postgres do docker compose na sua máquina (localhost:5433).
# Diferente de 5432 para não colidir com um Postgres instalado localmente.
# Só é usada pelo docker compose.
DB_PORTA_DOCKER=5433

# JWT (obrigatória: JWT_SECRET; use uma chave longa e aleatória)
JWT_SECRET=
JWT_EXPIRA_HORAS=24

# CORS e origem do WebSocket (separado por vírgula)
CORS_ORIGINS=http://localhost:3000

# Tempo real
POLL_INTERVAL_MS=2000

# Fuso usado nos limites de dia e agrupamentos
APP_TIMEZONE=America/Sao_Paulo

# Swagger UI em /swagger/index.html
SWAGGER_ENABLED=true
