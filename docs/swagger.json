{
    "swagger": "2.0",
    "info": {
        "description": "API do Pulso, o dashboard de BI da Fábrica de Software. Toda a regra de cálculo dos cards fica aqui; o front só desenha o que a API devolve.\nPara usar as rotas protegidas: faça POST /auth/login, copie o \"token\" da resposta, clique em \"Authorize\" e informe \"Bearer \u003ctoken\u003e\".",
        "title": "Pulso API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Autentica com e-mail e senha de um usuário ativo e devolve um JWT (HS256). Qualquer falha de credencial devolve 401 com a mesma mensagem genérica.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "Credenciais",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.LoginInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controllers.LoginRespostaDoc"
                        }
                    },
                    "400": {
                        "description": "Corpo inválido ou campos vazios",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "401": {
                        "description": "E-mail ou senha inválidos",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Devolve os dados do usuário dono do token e do perfil dele.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Usuário logado",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controllers.MeRespostaDoc"
                        }
                    },
                    "401": {
                        "description": "Sem token, token inválido ou usuário inativo",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    }
                }
            }
        },
        "/dashboards": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Devolve os dashboards ativos que têm ao menos um card ativo permitido ao perfil do usuário, com a quantidade desses cards (total_cards). Lista vazia se o perfil não vê nenhum.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboards"
                ],
                "summary": "Lista os dashboards visíveis",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controllers.ListaDashboardsDoc"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    }
                }
            }
        },
        "/dashboards/{chave}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Devolve o dashboard e os cards ativos que o perfil pode ver (codigo, titulo, descricao e tipo), ordenados por código e sem os dados calculados. A descricao é o texto do modal de informação.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboards"
                ],
                "summary": "Detalhe de um dashboard",
                "parameters": [
                    {
                        "enum": [
                            "projetos",
                            "vendas",
                            "ia"
                        ],
                        "type": "string",
                        "description": "Chave do dashboard",
                        "name": "chave",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controllers.DashboardDetalheDoc"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "403": {
                        "description": "Você não tem acesso a este recurso",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "404": {
                        "description": "Dashboard inexistente ou inativo",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErroDoc"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Devolve o status da API e do banco. Responde 503 se o banco não responder ao ping.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Verifica a saúde da API",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controllers.HealthResposta"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/controllers.HealthResposta"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controllers.DashboardDetalheDoc": {
            "type": "object",
            "properties": {
                "dados": {
                    "$ref": "#/definitions/models.DashboardDetalhe"
                },
                "sucesso": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "controllers.ErroDoc": {
            "type": "object",
            "properties": {
                "erro": {
                    "type": "string",
                    "example": "mensagem de erro"
                },
                "sucesso": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "controllers.HealthResposta": {
            "type": "object",
            "properties": {
                "banco": {
                    "type": "string",
                    "example": "ok"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "controllers.ListaDashboardsDoc": {
            "type": "object",
            "properties": {
                "dados": {
                    "$ref": "#/definitions/models.ListaDashboards"
                },
                "sucesso": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "controllers.LoginRespostaDoc": {
            "type": "object",
            "properties": {
                "dados": {
                    "$ref": "#/definitions/models.LoginResposta"
                },
                "sucesso": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "controllers.MeRespostaDoc": {
            "type": "object",
            "properties": {
                "dados": {
                    "$ref": "#/definitions/models.MeResposta"
                },
                "sucesso": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "models.CardMeta": {
            "type": "object",
            "properties": {
                "codigo": {
                    "type": "string",
                    "example": "proj-01"
                },
                "descricao": {
                    "type": "string",
                    "example": "Mostra quanto do trabalho planejado já foi concluído."
                },
                "tipo": {
                    "type": "string",
                    "example": "numero"
                },
                "titulo": {
                    "type": "string",
                    "example": "Progresso"
                }
            }
        },
        "models.DashboardDetalhe": {
            "type": "object",
            "properties": {
                "cards": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.CardMeta"
                    }
                },
                "chave": {
                    "type": "string",
                    "example": "projetos"
                },
                "descricao": {
                    "type": "string",
                    "example": "Andamento dos projetos em desenvolvimento."
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "titulo": {
                    "type": "string",
                    "example": "Projetos"
                }
            }
        },
        "models.DashboardResumo": {
            "type": "object",
            "properties": {
                "chave": {
                    "type": "string",
                    "example": "projetos"
                },
                "descricao": {
                    "type": "string",
                    "example": "Andamento dos projetos em desenvolvimento."
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "titulo": {
                    "type": "string",
                    "example": "Projetos"
                },
                "total_cards": {
                    "type": "integer",
                    "example": 15
                }
            }
        },
        "models.ListaDashboards": {
            "type": "object",
            "properties": {
                "dashboards": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.DashboardResumo"
                    }
                }
            }
        },
        "models.LoginInput": {
            "type": "object",
            "required": [
                "email",
                "senha"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "diretoria@pulso.local"
                },
                "senha": {
                    "type": "string",
                    "example": "sua_senha"
                }
            }
        },
        "models.LoginResposta": {
            "type": "object",
            "properties": {
                "expira_em": {
                    "type": "string",
                    "example": "2026-11-15T12:00:00-03:00"
                },
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "usuario": {
                    "$ref": "#/definitions/models.UsuarioResumo"
                }
            }
        },
        "models.MeResposta": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "diretoria@pulso.local"
                },
                "id": {
                    "type": "string",
                    "example": "5b1f8a2e-3c4d-4e5f-8a9b-0c1d2e3f4a5b"
                },
                "nome": {
                    "type": "string",
                    "example": "Diretoria (dev)"
                },
                "perfil": {
                    "$ref": "#/definitions/models.PerfilResumo"
                }
            }
        },
        "models.PerfilResumo": {
            "type": "object",
            "properties": {
                "descricao": {
                    "type": "string",
                    "example": "Acesso a todos os dashboards e cards, incluindo vendas."
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "nome": {
                    "type": "string",
                    "example": "diretoria"
                }
            }
        },
        "models.UsuarioResumo": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "diretoria@pulso.local"
                },
                "id": {
                    "type": "string",
                    "example": "5b1f8a2e-3c4d-4e5f-8a9b-0c1d2e3f4a5b"
                },
                "nome": {
                    "type": "string",
                    "example": "Diretoria (dev)"
                },
                "perfil": {
                    "type": "string",
                    "example": "diretoria"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Informe o valor no formato \"Bearer \u003ctoken\u003e\" (com a palavra Bearer e um espaço antes do token).",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}